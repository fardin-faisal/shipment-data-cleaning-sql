-- ** Standardize Text Formatting **

-- # For "origin_warehouse"
SELECT origin_warehouse, 
       CONCAT(
           UPPER(SUBSTRING(origin_warehouse, 1, 1)), 
           LOWER(SUBSTRING(origin_warehouse, 2, 9)), 
           UPPER(RIGHT(origin_warehouse, 1))
       )
FROM cleaned_shipments2;

-- Or alternative:
SELECT origin_warehouse,
       CONCAT(
           'Warehouse ',
           UPPER(RIGHT(origin_warehouse, 1))
       )
FROM cleaned_shipments2;

-- Now update
SET SQL_SAFE_UPDATES = 0;
UPDATE cleaned_shipments2
SET origin_warehouse = CONCAT(
    UPPER(SUBSTRING(origin_warehouse, 1, 1)), 
    LOWER(SUBSTRING(origin_warehouse, 2, 9)), 
    UPPER(RIGHT(origin_warehouse, 1))
);

-- Check
SELECT origin_warehouse
FROM cleaned_shipments2;

-- # For "destination_city"
SELECT DISTINCT destination_city
FROM cleaned_shipments2;

SELECT destination_city,
       CASE
           WHEN destination_city NOT LIKE '% %' THEN 
               CONCAT(
                   UPPER(LEFT(destination_city, 1)),
                   LOWER(SUBSTRING(destination_city, 2))
               )
           ELSE 
               CONCAT(
                   UPPER(LEFT(SUBSTRING_INDEX(destination_city, ' ', 1), 1)),
                   LOWER(SUBSTRING(SUBSTRING_INDEX(destination_city, ' ', 1), 2)),
                   ' ',
                   UPPER(LEFT(SUBSTRING_INDEX(destination_city, ' ', -1), 1)),
                   LOWER(SUBSTRING(SUBSTRING_INDEX(destination_city, ' ', -1), 2))
               )
       END
FROM cleaned_shipments2;

