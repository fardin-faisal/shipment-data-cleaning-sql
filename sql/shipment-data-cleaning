-- For 'weight_kg'
SELECT shipment_id, weight_kg,
       CASE
           WHEN weight_kg < 0 THEN ABS(weight_kg)
           WHEN weight_kg = 0 THEN NULL
           ELSE weight_kg
       END
FROM cleaned_shipments2;

SET SQL_SAFE_UPDATES = 0;
UPDATE cleaned_shipments2
SET weight_kg = CASE
    WHEN weight_kg < 0 THEN ABS(weight_kg)
    WHEN weight_kg = 0 THEN NULL
    ELSE weight_kg
END;


