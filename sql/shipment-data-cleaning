-- ============================================================================
-- STEP 1: CREATE A CLEAN WORKING TABLE
-- ============================================================================

-- # Step 1.1: Create the table without data
CREATE TABLE cleaned_shipments
LIKE shipment_db.raw_shipments;

-- Then insert data
INSERT cleaned_shipments
SELECT *
FROM raw_shipments;
 
-- Check the table
SELECT *
FROM cleaned_shipments;


-- # Step 1.2: Create table by copying all data
CREATE TABLE cleaned_shipments2 AS 
SELECT * FROM raw_shipments;

-- Check the table
SELECT *
FROM cleaned_shipments2;


-- ============================================================================
-- STEP 2: CLEANING STARTS
-- ============================================================================

-- STEP 2.1: Remove Duplicates
-- ----------------------------------------------------------------------------

-- Find and List Duplicate IDs (With Counts)
SELECT shipment_id,
       COUNT(*) AS total_occurance
FROM cleaned_shipments2
GROUP BY shipment_id
HAVING total_occurance > 1;
-- Output: No duplicate IDs, all are unique

-- Let's check for identical origin_warehouse, destination_city, carrier, ship_date, weight_kg, freight_cost
WITH CTE AS (
    SELECT 
        *,
        ROW_NUMBER() OVER(
            PARTITION BY origin_warehouse, destination_city, carrier, ship_date, weight_kg, freight_cost
            ORDER BY shipment_id
        ) AS row_num
    FROM cleaned_shipments2
)
SELECT *
FROM CTE
WHERE row_num > 1;

-- Or alternative check:
SELECT * 
FROM cleaned_shipments2
WHERE shipment_id IN (
    SELECT shipment_id 
    FROM ( 
        SELECT shipment_id,
            ROW_NUMBER() OVER(
                PARTITION BY origin_warehouse, destination_city, carrier, ship_date, weight_kg, freight_cost
                ORDER BY shipment_id
            ) AS row_num
        FROM cleaned_shipments2
    ) AS subquery
    WHERE row_num > 1
);

-- Let's delete duplicates
DELETE FROM cleaned_shipments2
WHERE shipment_id IN (
    SELECT shipment_id 
    FROM ( 
        SELECT shipment_id,
            ROW_NUMBER() OVER(
                PARTITION BY origin_warehouse, destination_city, carrier, ship_date, weight_kg, freight_cost
                ORDER BY shipment_id
            ) AS row_num
        FROM cleaned_shipments2
    ) AS subquery
    WHERE row_num > 1
);


-- STEP 2.2: Standardizing the Data
