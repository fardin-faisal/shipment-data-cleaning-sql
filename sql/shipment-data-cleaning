-- Another way for multiple type date format changing to one format
SELECT shipment_id, ship_date,
       CASE
           WHEN ship_date LIKE '%/%/%' AND SUBSTRING_INDEX(ship_date, '/', 1) <= 12
               THEN str_to_date(ship_date, '%m/%d/%Y')
           WHEN ship_date LIKE '%/%/%' AND LENGTH(SUBSTRING_INDEX(ship_date, '/', 1)) = 4
               THEN str_to_date(ship_date, '%Y/%m/%d')
           WHEN ship_date LIKE '___ % %' 
               THEN STR_TO_DATE(ship_date, '%b %d %Y')
           WHEN ship_date LIKE '% % %' AND ship_date NOT LIKE '___ % %' 
               THEN STR_TO_DATE(ship_date, '%M %d %Y')
           ELSE ship_date
       END
FROM cleaned_shipments2;

UPDATE cleaned_shipments2
SET ship_date = CASE
    WHEN ship_date LIKE '%/%/%' AND SUBSTRING_INDEX(ship_date, '/', 1) <= 12
        THEN str_to_date(ship_date, '%m/%d/%Y')
    WHEN ship_date LIKE '%/%/%' AND LENGTH(SUBSTRING_INDEX(ship_date, '/', 1)) = 4
        THEN str_to_date(ship_date, '%Y/%m/%d')
    WHEN ship_date LIKE '___ % %' 
        THEN STR_TO_DATE(ship_date, '%b %d %Y')
    WHEN ship_date LIKE '% % %' AND ship_date NOT LIKE '___ % %' 
        THEN STR_TO_DATE(ship_date, '%M %d %Y')
    ELSE ship_date
END;


