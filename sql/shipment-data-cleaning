-- ** Remove Trailing / Leading Whitespace **

-- # For "origin_warehouse"
-- Checking if any trailing / leading whitespace available
SELECT DISTINCT origin_warehouse
FROM cleaned_shipments2;
-- Output: Available

-- Let's remove using TRIM() & update table
SELECT origin_warehouse, 
       TRIM(origin_warehouse)
FROM cleaned_shipments2;

SET SQL_SAFE_UPDATES = 0;
UPDATE cleaned_shipments2
SET origin_warehouse = TRIM(origin_warehouse);
-- Output: Successful

-- # For "destination_city" 
SELECT destination_city, 
       TRIM(destination_city) 
FROM cleaned_shipments2;

UPDATE cleaned_shipments2
SET destination_city = TRIM(destination_city);
-- Output: Successful

-- # For "destination_state" 
SELECT destination_state, 
       TRIM(destination_state) 
FROM cleaned_shipments2;
-- Output: No trailing / leading whitespace available

-- # For "carrier" 
SELECT * 
FROM cleaned_shipments2;

SELECT carrier, 
       TRIM(carrier) 
FROM cleaned_shipments2;

UPDATE cleaned_shipments2
SET carrier = TRIM(carrier);
-- Output: Successful

-- For the remaining columns also, no trailing / leading whitespace available.

